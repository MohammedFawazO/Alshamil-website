# .env.example — Copy this to .env and fill in your values
# NEVER commit .env to Git — add it to .gitignore

DJANGO_SECRET_KEY=your_secret_key_here
DEBUG=True

# Hostinger Email Settings
# EMAIL_HOST_USER must be the full Hostinger mailbox address
# EMAIL_HOST_PASSWORD is the password set in Hostinger → Email → Manage → Edit Mailbox
EMAIL_HOST_USER=your_email@domain.com
EMAIL_HOST_PASSWORD=your_hostinger_mailbox_password_here
CONTACT_EMAIL=your_email@domain.com
DEFAULT_FROM_EMAIL=your_email@domain.com

# For production (Render), set DATABASE_URL to your PostgreSQL URL